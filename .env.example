# .env.example
GEMINI_API_KEY=
FIREBASE_API_KEY=

# Trusted backend credentials: use an attached Google service account in production.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-project-id
# HR_DATA_DIR=/persistent/private/hr-data
# First installation only: private temporary password for the initial HR admin.
# BOOTSTRAP_ADMIN_PASSWORD=
# Offline development / tests only:
# FIRESTORE_DISABLED=true
